        "forge-1.20.1/src/main/java/cn/laowu/mod/item/CatFilterLogic.java"
      ]
    },
    {
      "id": "laowu:adoption_box",
      "name": "领养箱",
      "description": "放入猫饼后，等待领养完成可获得交易物资；猫咪属性会参与品质评分，影响领养处理。若箱体四个水平侧面紧邻的坐垫上坐有具备职业的村民，奖励按这些村民的职业生成，否则从随机职业生成。领养会消耗投入的猫饼，奖励区放不下时会等待腾出空间。",
      "sourceFiles": [
        "forge-1.20.1/src/main/resources/assets/laowu/lang/zh_cn.json",
        "forge-1.20.1/src/main/java/cn/laowu/mod/LaoWuMod.java",
