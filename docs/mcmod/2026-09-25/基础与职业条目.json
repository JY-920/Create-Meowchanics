        "forge-1.20.1/src/main/java/cn/laowu/mod/create/AdoptionRewardTable.java"
      ]
    },
    {
      "id": "laowu:wish_adoption_box",
      "name": "心愿领养箱",
      "description": "将满足本次全部条件的猫饼放入输入区，可立即兑换界面展示的饰品。NOW检查当前基础属性，不计词条、套装、饰品与临时加成；MAX检查属性上限。锁定交易后，成功兑换不会更换条件与奖励；猫饼及其携带物品会一并被领养。",
      "sourceFiles": [
        "forge-1.20.1/src/main/resources/assets/laowu/lang/zh_cn.json",
