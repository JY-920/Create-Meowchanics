  "entries": [
    {
      "id": "laowu:cat_pancake",
      "name": "猫饼",
      "description": "保存猫咪数据的物品形态，可保留猫咪的外观、主人、职业及属性信息。将猫饼放入运转中的机械动力鼓风机气流，可恢复为猫咪。猫袋收纳和死亡掉落并非同一种处理：死亡造成的属性损失取决于世界设置。",
      "sourceFiles": [
        "forge-1.20.1/src/main/resources/assets/laowu/lang/zh_cn.json",
        "forge-1.20.1/src/main/java/cn/laowu/mod/LaoWuMod.java",
        "forge-1.20.1/src/main/java/cn/laowu/mod/item/CatPancakeItem.java",
        "forge-1.20.1/src/main/java/cn/laowu/mod/item/CatPouchItem.java"
      ]
    },
    {
      "id": "laowu:cat_pouch",
      "name": "猫袋",
      "description": "右键猫咪或处于猫饼姿势的猫，可将其收进猫袋；容量为128只。也可在物品栏内右键装入或取出猫饼，取出顺序为后放入的先取出。正在被查看、骑乘或处于部分特殊动作中的猫暂时不能收纳；普通收纳不会触发死亡属性惩罚。",
      "sourceFiles": [
        "forge-1.20.1/src/main/resources/assets/laowu/lang/zh_cn.json",
        "forge-1.20.1/src/main/java/cn/laowu/mod/LaoWuMod.java",
        "forge-1.20.1/src/main/java/cn/laowu/mod/item/CatPouchItem.java"
      ]
    },
    {
      "id": "laowu:cat_filter",
      "name": "猫咪过滤器",
      "description": "用于按属性、属性上限、词条、成长状态、主人状态、职业和名称筛选猫饼。属性组与词条组可设置全部满足、任意满足和反向选择，身份条件始终需要全部满足。右键心愿领养箱会清空旧条件，并导入当前交易的NOW基础属性和MAX属性上限范围；非猫饼或没有属性数据的猫饼不能通过。",
      "sourceFiles": [
        "forge-1.20.1/src/main/resources/assets/laowu/lang/zh_cn.json",
        "forge-1.20.1/src/main/java/cn/laowu/mod/LaoWuMod.java",
