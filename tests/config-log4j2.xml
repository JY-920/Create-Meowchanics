<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%level: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers><Root level="ERROR"><AppenderRef ref="Console"/></Root></Loggers>
</Configuration>
